# Python
.venv/
__pycache__/
*.pyc

# macOS
.DS_Store

# Ultralytics çıktıları ve ağırlıklar
runs/
*.pt
!modeller/best.pt

# Veri seti görüntüleri (büyük dosyalar repoya girmesin)
